# Copy this file to .env and fill in real values. Never commit the real .env file.

# development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=4000

# MongoDB connection string (MONGO_URI is also accepted as a fallback name)
MONGO_URL=mongodb://localhost:27017/careersync

# Required. Signs/verifies short-lived ACCESS token JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Required. Signs/verifies REFRESH token JWTs. Must be a DIFFERENT value than
# JWT_SECRET so a leak of one secret can't be used to forge the other token type.
JWT_REFRESH_SECRET=

# Access/refresh token lifetimes (jsonwebtoken "zeit/ms" style strings)
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# The frontend origin used for CORS and for building links in outgoing emails
# (e.g. email verification links). REQUIRED when NODE_ENV=production - the server
# refuses to start in production without it rather than silently falling back to
# http://localhost:3000. FRONTEND_URL is accepted as an alias.
CLIENT_URL=http://localhost:3000

# bcrypt cost factor for password hashing (defaults to 10 if unset)
SALT_ROUNDS=10

# Outgoing SMTP (verification emails). Falls back to an Ethereal test inbox in
# development if left unset - real delivery requires all four in production.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# CV storage backend. "local" (default) writes to local disk and does NOT work across
# multiple instances of the app. No other provider is implemented yet - see the
# migration plan documented at the top of utils/cvStorage.js before setting this to
# anything else; an unrecognized value fails fast at startup rather than silently
# falling back.
CV_STORAGE_PROVIDER=local

# AI service (services/ai). Leave unset to run entirely against deterministic,
# dependency-free fakes (services/ai/providers/fakeProvider.js) - safe for local dev
# and CI, produces no real model output. Set a real key to use the OpenAI provider
# instead (services/ai/providers/openAiProvider.js) - NOTE: that provider has not been
# exercised against a live API in this environment; smoke-test it before trusting it.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Derived embedding index (services/embeddings). With no OpenAI key, the existing fake
# provider supplies a deterministic 32-dimensional vector for local development and CI.
# MongoDB stores derived vectors privately; it remains the authoritative data store.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
EMBEDDING_VERSION=v1

# Per-call timeout and retry budget for every AI provider call (see services/ai/aiService.js)
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_RETRIES=1
